# ---- What you sell (drives scores, briefs and draft emails) ----
SENDER_OFFER=            # e.g. "a cloud cost platform that cuts AWS bills 20-30%"
TARGET_ICP=              # e.g. "B2B SaaS and logistics companies, 100-2000 employees"
SENDER_NAME=             # signature in draft emails
OFFER_KEYWORDS=          # comma list matched against job mandates/stack for a score boost, e.g. cloud,aws,cost,kubernetes

# ---- What to watch ----
WATCH_ROLES=cto,deputy_cto,vp_engineering,cio,ciso,chief_data,chief_digital,head_engineering   # "all" = every role (see `hiring-tracker roles`)
NOTIFY_MIN_SCORE=60      # only alerts at/above this score are sent (hot >= 80, warm >= 60)
CLOSE_AFTER_SCANS=2      # a posting must be missing this many scans in a row to count as closed
FILLED_MIN_DAYS=14       # closed after >= this many days open = "likely filled"
SURGE_ALERTS=true        # engineering hiring surge alerts
SURGE_RATIO=1.5
SURGE_MIN_JOBS=5

# ---- Notifications (any combination; leave empty to only write reports) ----
SLACK_WEBHOOK_URL=       # https://api.slack.com/messaging/webhooks (per-target "slackWebhook" routes to the owner's channel)
TEAMS_WEBHOOK_URL=       # Teams Workflows "post to a channel when a webhook request is received"
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=          # https://resend.com - email alerts (also sent to each target's ownerEmail)
EMAIL_FROM=              # e.g. "Hiring Signals <signals@yourdomain.com>" (verified domain)
EMAIL_TO=                # comma list, e.g. sales-team@yourcompany.com
WEBHOOK_URL=             # Zapier / Make / n8n / CRM - receives {"event":"hiring_signal","alert":{...}}
WEBHOOK_SECRET=          # sent as x-webhook-secret

# ---- REST API ----
API_KEY=                 # required header x-api-key for /api/* (set this in production)
PORT=3000

# ---- AI briefs (optional; rule-based briefs are used without keys) ----
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GROQ_API_KEY=              # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=            # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-flash-latest,gemini:gemini-3.6-flash,...   (provider:model, comma separated)
AI_TIMEOUT_MS=10000        # per model, while another model is left to try
AI_TOTAL_BUDGET_MS=30000   # whole answer
AI_HEDGE_MS=6000           # start the next model in parallel if the current one is silent this long (0 = off)
MAX_AI_BRIEFS=15           # AI briefs per scan (best alerts first); the rest use rules

# ---- Crawling ----
SCAN_CONCURRENCY=4
HTTP_TIMEOUT_MS=25000
HOST_GAP_MS=400            # pause between requests to the same host
RESPECT_ROBOTS=true        # robots.txt check for HTML careers pages
# TRACKER_HOME=            # folder with config/, data/, output/ (default: current folder)
