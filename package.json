{
  "name": "job-board-hiring-signal-tracker",
  "version": "1.0.0",
  "description": "Watches target companies' job boards (Greenhouse, Lever, Ashby, Workable, SmartRecruiters, Recruitee, Personio, any careers page) and alerts sales reps when a company is hiring or has just hired a CTO or other tech executive.",
  "type": "module",
  "bin": {
    "hiring-tracker": "bin/hiring-tracker.js"
  },
  "main": "src/tracker.js",
  "scripts": {
    "start": "node bin/hiring-tracker.js serve",
    "scan": "node bin/hiring-tracker.js scan",
    "demo": "node bin/hiring-tracker.js demo",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "sales-intelligence",
    "hiring-signals",
    "cto",
    "job-board",
    "cheerio",
    "greenhouse",
    "lever",
    "ashby",
    "lead-generation"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "express": "^5.3.0"
  }
}
